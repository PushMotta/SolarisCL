{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m unittest:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(python scripts/*)",
      "Bash(python3 scripts/*)",
      "Bash(python -m hsl.cli:*)",
      "Bash(./bin/hsl:*)",
      "Bash(husk --help)",
      "Bash(husk --list-renderers)",
      "Bash(hython -c:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Read(//mnt/**)",
      "Edit(hsl/**)",
      "Edit(tests/**)",
      "Edit(docs/**)"
    ],
    "ask": [
      "Bash(husk:*)",
      "Bash(hython:*)",
      "Edit(.claude/**)",
      "Edit(.agents/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/*.hip)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/boundary_guard.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 -m unittest discover -s tests -q 2>&1 | tail -5"
          }
        ]
      }
    ]
  }
}
